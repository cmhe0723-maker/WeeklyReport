<%- include('../partials/header') %>
<% const v = (k) => report[k] || ''; %>
<div class="page-head">
  <h1><%= title %></h1>
  <a href="<%= report.id ? '/reports/' + report.id : '/reports' %>">← 返回</a>
</div>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>

<form method="post" action="<%= report.id ? '/reports/' + report.id : '/reports' %>" class="card stack report-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field-row">
    <label>週次（選擇該週任一天）
      <% if (report.id) { %>
        <input type="text" value="<%= util.weekLabel(report.week_start) %>" disabled>
      <% } else { %>
        <input type="date" name="week_start" value="<%= report.week_start %>" required data-week-picker>
      <% } %>
    </label>
    <div class="muted small" data-week-label><%= util.weekLabel(report.week_start) %></div>
  </div>

  <% if (prev) { %>
  <details class="prev-plan">
    <summary>參考：上次填寫的「下週工作計畫」（<%= util.weekLabel(prev.week_start) %>）</summary>
    <div class="pre"><%= prev.next_week_plan %></div>
  </details>
  <% } %>

  <label><span>本週工作內容 <span class="req">*</span></span>
    <textarea name="work_summary" rows="7" maxlength="10000" placeholder="例：&#10;1. 拜訪 A 公司，說明新方案&#10;2. 完成 B 案報價"><%= v('work_summary') %></textarea>
  </label>
  <label>客戶拜訪紀錄
    <textarea name="customer_visits" rows="5" maxlength="10000" placeholder="客戶名稱／拜訪日期／洽談重點"><%= v('customer_visits') %></textarea>
  </label>
  <label>業績與案件進度
    <textarea name="sales_progress" rows="4" maxlength="10000" placeholder="成交金額、報價中案件、預計結案時間等"><%= v('sales_progress') %></textarea>
  </label>
  <label>下週工作計畫
    <textarea name="next_week_plan" rows="5" maxlength="10000"><%= v('next_week_plan') %></textarea>
  </label>
  <label>問題與需協助事項
    <textarea name="issues" rows="3" maxlength="10000"><%= v('issues') %></textarea>
  </label>

  <div class="actions">
    <% if (report.status === 'submitted') { %>
      <button class="btn" name="action" value="draft" data-confirm="改回草稿後主管將看不到這份週報，確定嗎？">改回草稿</button>
      <button class="btn btn-primary" name="action" value="submit">更新並提交</button>
    <% } else { %>
      <button class="btn" name="action" value="draft">儲存草稿</button>
      <button class="btn btn-primary" name="action" value="submit">提交給主管</button>
    <% } %>
  </div>
</form>
<%- include('../partials/footer') %>
