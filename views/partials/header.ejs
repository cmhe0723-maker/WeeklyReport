<!doctype html>
<html lang="zh-Hant">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %>｜業務週報系統</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
<% if (currentUser) { %>
<header class="topbar">
  <div class="topbar-inner">
    <a class="brand" href="/">業務週報系統</a>
    <nav class="nav">
      <% if (currentUser.role !== 'admin') { %>
        <a href="/reports" class="<%= path.startsWith('/reports') ? 'active' : '' %>">我的週報</a>
      <% } %>
      <% if (currentUser.role !== 'staff') { %>
        <a href="/review" class="<%= path.startsWith('/review') ? 'active' : '' %>">週報查閱</a>
      <% } %>
      <% if (currentUser.role === 'admin') { %>
        <a href="/admin/users" class="<%= path.startsWith('/admin/users') ? 'active' : '' %>">人員與權限</a>
        <a href="/admin/departments" class="<%= path.startsWith('/admin/departments') ? 'active' : '' %>">部門管理</a>
      <% } %>
    </nav>
    <div class="me">
      <span class="me-name"><%= currentUser.name %><small><%= util.ROLE_LABELS[currentUser.role] %><%= currentUser.department_name ? '・' + currentUser.department_name : '' %></small></span>
      <a href="/account/password">變更密碼</a>
      <form method="post" action="/logout" class="inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button class="link">登出</button>
      </form>
    </div>
  </div>
</header>
<% } %>
<main class="container">
<% if (flash) { %>
  <div class="alert alert-<%= flash.type %>"><%= flash.text %></div>
<% } %>
