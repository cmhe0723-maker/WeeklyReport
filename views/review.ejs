<%- include('partials/header') %>
<div class="page-head">
  <h1>週報查閱</h1>
  <a class="pending-pill <%= pendingTotal ? '' : 'zero' %>" href="/review?week=all&status=pending">全部待查閱：<strong><%= pendingTotal %></strong> 份</a>
</div>

<% if (!departments.length) { %>
  <div class="alert alert-warning">您目前沒有被指派任何可查閱的部門，請洽系統管理員設定。</div>
<% } %>

<form method="get" action="/review" class="card filters">
  <div class="week-nav">
    <% if (week) { %>
      <a class="btn btn-sm" href="/review?week=<%= prevWeek %>&dept=<%= deptFilter || '' %>&status=<%= status %>">‹ 上週</a>
    <% } %>
    <input type="date" name="week" value="<%= week || '' %>" data-autosubmit>
    <% if (week) { %>
      <a class="btn btn-sm" href="/review?week=<%= nextWeek %>&dept=<%= deptFilter || '' %>&status=<%= status %>">下週 ›</a>
    <% } %>
    <a class="btn btn-sm <%= week === thisWeek ? 'btn-primary' : '' %>" href="/review?week=<%= thisWeek %>&dept=<%= deptFilter || '' %>&status=<%= status %>">本週</a>
    <a class="btn btn-sm <%= !week ? 'btn-primary' : '' %>" href="/review?week=all&dept=<%= deptFilter || '' %>&status=<%= status %>">所有週次</a>
  </div>
  <div class="row-gap">
    <select name="dept" data-autosubmit>
      <option value="">全部部門</option>
      <% for (const d of departments) { %><option value="<%= d.id %>" <%= d.id === deptFilter ? 'selected' : '' %>><%= d.name %></option><% } %>
    </select>
    <select name="status" data-autosubmit>
      <option value="all" <%= status === 'all' ? 'selected' : '' %>>全部狀態</option>
      <option value="pending" <%= status === 'pending' ? 'selected' : '' %>>待查閱</option>
      <option value="reviewed" <%= status === 'reviewed' ? 'selected' : '' %>>已查閱</option>
      <% if (week) { %><option value="missing" <%= status === 'missing' ? 'selected' : '' %>>未提交</option><% } %>
    </select>
    <noscript><button class="btn btn-sm">篩選</button></noscript>
  </div>
</form>

<% if (week) { %>
  <h2 class="section-title"><%= util.weekLabel(week) %></h2>
  <div class="stats">
    <div class="stat"><span><%= summary.total %></span>應填人數</div>
    <div class="stat stat-muted"><span><%= summary.missing %></span>未提交</div>
    <div class="stat stat-warn"><span><%= summary.pending %></span>待查閱</div>
    <div class="stat stat-ok"><span><%= summary.reviewed %></span>已查閱</div>
  </div>
<% } else { %>
  <h2 class="section-title">所有週次已提交週報</h2>
<% } %>

<form method="post" action="/review/batch" class="card">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <input type="hidden" name="back" value="<%= backUrl %>">
  <% if (!rows.length) { %>
    <p class="muted center">沒有符合條件的資料。</p>
  <% } else { %>
  <div class="table-wrap">
  <table>
    <thead><tr>
      <th class="check"><input type="checkbox" data-check-all title="全選待查閱"></th>
      <% if (!week) { %><th>週次</th><% } %>
      <th>部門</th><th>姓名</th><th>狀態</th><th>內容摘要</th><th>查閱</th><th></th>
    </tr></thead>
    <tbody>
    <% for (const r of rows) { %>
      <tr class="state-<%= r.state %>">
        <td class="check"><% if (r.state === 'pending') { %><input type="checkbox" name="ids" value="<%= r.id %>"><% } %></td>
        <% if (!week) { %><td class="nowrap"><%= util.weekLabel(r.week_start) %></td><% } %>
        <td class="nowrap"><%= r.department_name || '—' %></td>
        <td class="nowrap"><%= r.author_name %><% if (r.role === 'manager') { %> <span class="tag">主管</span><% } %></td>
        <td><%- include('partials/badge', { state: r.state }) %></td>
        <td class="summary"><% if (r.state === 'pending' || r.state === 'reviewed') { %><%= (r.work_summary || '').slice(0, 60) %><%= (r.work_summary || '').length > 60 ? '…' : '' %><% } else { %><span class="muted">—</span><% } %></td>
        <td class="nowrap small"><% if (r.reviewed_at) { %><%= r.reviewer_name || '—' %><br><span class="muted"><%= util.fmtDateTime(r.reviewed_at) %></span><% } else { %><span class="muted">—</span><% } %></td>
        <td class="nowrap right"><% if (r.state === 'pending' || r.state === 'reviewed') { %><a class="btn btn-sm" href="/reports/<%= r.id %>?back=<%= encodeURIComponent(backUrl) %>">查看</a><% } %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
  </div>
  <% if (rows.some(r => r.state === 'pending')) { %>
    <div class="actions"><button class="btn btn-primary" data-confirm="確定將勾選的週報標記為查閱完成？">✔ 勾選項目標記為查閱完成</button></div>
  <% } %>
  <% } %>
</form>
<%- include('partials/footer') %>
