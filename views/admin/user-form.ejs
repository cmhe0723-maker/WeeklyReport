<%- include('../partials/header') %>
<div class="page-head">
  <h1><%= title %></h1>
  <a href="/admin/users">← 返回</a>
</div>
<% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
<% if (!departments.length) { %><div class="alert alert-warning">尚未建立部門，請先到 <a href="/admin/departments">部門管理</a> 新增部門。</div><% } %>

<form method="post" action="<%= user.id ? '/admin/users/' + user.id : '/admin/users' %>" class="card stack narrow-form">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="field-grid">
    <label>登入帳號<input name="username" value="<%= user.username %>" pattern="[A-Za-z0-9._\-]{3,50}" required autocomplete="off"></label>
    <label>姓名<input name="name" value="<%= user.name %>" maxlength="50" required></label>
    <label>角色
      <select name="role" data-role-select>
        <% for (const r of ['staff', 'manager', 'admin']) { %>
          <option value="<%= r %>" <%= user.role === r ? 'selected' : '' %>><%= util.ROLE_LABELS[r] %></option>
        <% } %>
      </select>
    </label>
    <label>所屬部門
      <select name="department_id">
        <option value="">（無）</option>
        <% for (const d of departments) { %><option value="<%= d.id %>" <%= d.id === user.department_id ? 'selected' : '' %>><%= d.name %></option><% } %>
      </select>
    </label>
  </div>

  <fieldset class="managed" data-managed>
    <legend>可查閱的部門（主管專用）</legend>
    <% if (!departments.length) { %><span class="muted">尚無部門</span><% } %>
    <% for (const d of departments) { %>
      <label class="check-label"><input type="checkbox" name="managed" value="<%= d.id %>" <%= (user.managed || []).includes(d.id) ? 'checked' : '' %>> <%= d.name %></label>
    <% } %>
  </fieldset>

  <label><%= user.id ? '重設密碼（留空表示不變更）' : '初始密碼（至少 8 個字元）' %>
    <input type="password" name="password" minlength="8" <%= user.id ? '' : 'required' %> autocomplete="new-password">
  </label>
  <p class="muted small">設定或重設密碼後，該人員下次登入時需自行變更密碼。</p>

  <label class="check-label"><input type="checkbox" name="active" value="1" <%= user.active ? 'checked' : '' %>> 帳號啟用（取消勾選即停用，無法登入）</label>

  <div class="actions"><button class="btn btn-primary">儲存</button></div>
</form>
<%- include('../partials/footer') %>
